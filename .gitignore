# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Runtime data (created on first run; never commit)
data/redsage.db
data/verify_all.db
data/test_sandbox.db
data/projects/
data/chroma/
data/*.db

# Frontend build artifacts
frontend/node_modules/
frontend/dist/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
*.tmp

# Migration safety exclusions
HERMES_REDSAGE_MIGRATION.zip
HERMES_REDSAGE_MIGRATION/**/.env
HERMES_REDSAGE_MIGRATION/**/auth.json
HERMES_REDSAGE_MIGRATION/**/.venv/
HERMES_REDSAGE_MIGRATION/**/.venv_test/
HERMES_REDSAGE_MIGRATION/**/node_modules/
HERMES_REDSAGE_MIGRATION/**/__pycache__/
HERMES_REDSAGE_MIGRATION/**/*.exe
HERMES_REDSAGE_MIGRATION/**/.git/
