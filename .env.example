# RedSage v2 environment template
# Copy to `.env` and fill in values. Never commit a real API key.

# Application
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# SQLite database for the workflow engine
DATABASE_URL=sqlite:///./data/redsage.db

# Optional Cohere verification/assistant key.
# When unset, the app runs fully offline with a local deterministic verifier.
CO_API_KEY=

# Knowledge base (core/) settings
REDSAGE_CHROMA_DIR=data/chroma
REDSAGE_DB=data/redsage.db
REDSAGE_COLLECTION=redsage_kb_local_v4
REDSAGE_EMBEDDING_PROVIDER=local
REDSAGE_TOP_K=5
REDSAGE_SCORE_THRESHOLD=0.15
