# RedSage v2 environment template
# Copy this file to `.env` and fill in values as needed.
# NEVER commit a real API key.

# Application
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# SQLite database for the workflow engine (file is created on first run)
DATABASE_URL=sqlite:///./data/redsage.db

# Optional Cohere verification key.
# When unset, the app runs fully offline with a local deterministic verifier
# and no evidence ever leaves the machine.
CO_API_KEY=
COHERE_API_KEY=
